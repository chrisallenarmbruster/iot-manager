# IoT Manager — chrisallenarmbruster/iot-manager

# Application
DOCKER_REGISTRY="registry.rev4labs.com"
DOCKER_IMAGE_NAME="iot-manager"
APP_VERSION="2.1.0"
APP_REPLICAS="1"
QUIET="true"
PORT="3000"
DCP_LISTEN_PORT="2500"

# Database
POSTGRES_DB="esp32-endpoints"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
DATABASE_URL=""

# Backups
BACKUP_REPLICAS="1"
POSTGRES_BACKUP_SCHEDULE="15 3 * * 0"
POSTGRES_BACKUP_TIMEZONE="America/Chicago"
POSTGRES_BACKUP_KEEP_MINUTES="10080"
POSTGRES_BACKUP_KEEP_DAYS="7"
POSTGRES_BACKUP_KEEP_WEEKS="4"
POSTGRES_BACKUP_KEEP_MONTHS="3"
